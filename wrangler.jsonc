// Cloudflare Workers configuration for Ive's website.
// Cloudflare reads this file on every deploy from GitHub.
{
    // must match the Worker's name in the Cloudflare dashboard
    "name": "ive",
    "main": "worker/index.js",
    "compatibility_date": "2025-10-01",

    // the website itself
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        // pages pass through worker/index.js, which fills in the contact
        // details and fees Ive saved in the admin page
        "run_worker_first": true
    },

    // keep variables you set in the dashboard (ACCESS_TEAM_DOMAIN, ACCESS_AUD,
    // CONTACT_TO, …) instead of wiping them on every deploy
    "keep_vars": true

    // STEP 2 — storage for the concerts, fees and contact details. After creating the KV namespace
    // in Cloudflare, put a comma after `true` above, remove the two slashes in
    // front of the three lines below, and paste the namespace ID:
    // "kv_namespaces": [
    //     { "binding": "EVENTS", "id": "PASTE-THE-KV-NAMESPACE-ID-HERE" }
    // ]
}
